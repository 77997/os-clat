# Settings of the simulated ISP in the shape of the public setup guide: a /64 by SLAAC on the WAN, a /56 by DHCPv6-PD,
# no PREF64 and no RDNSS in the RA (the subscriber enters the DNS64 servers by hand), PPP-Max-Payload echoed up to 1500.
# Timers, RA interval and RA flags are the simulator's own choices.
# KEY=value, no spaces, no quotes. Changed by ispctl; "ispctl defaults" copies isp.env.default over this file.
WAN_PREFIX=2001:db8:4800::/64
SLAAC=on
PD_PREFIX=2001:db8:4800:100::/56
PD_T1=1800
PD_T2=2880
PD_PREFERRED=3600
PD_VALID=7200
DNS_ADDR=2001:db8:64::53
DNS64=on
PREF64=off
PREF64_PREFIX=64:ff9b::/96
PREF64_LIFETIME=1800
RA_INTERVAL=600
RA_UNSOLICITED=on
RA_M=off
RA_O=off
RA_RDNSS=off
RA_MTU=auto
BNG_MTU=1500
IPV4=off
