# Settings of the simulated ISP, profile P0 (PREF64 and RDNSS in the RA, PPP MTU 1492). KEY=value, no spaces, no quotes.
# "ispctl defaults p0" copies this file over isp.env.
WAN_PREFIX=2001:db8:a::/64
SLAAC=on
PD_PREFIX=2001:db8:5600::/56
PD_T1=1800
PD_T2=2880
PD_PREFERRED=3600
PD_VALID=7200
DNS_ADDR=2001:db8:64::53
DNS64=on
PREF64=on
PREF64_PREFIX=64:ff9b::/96
PREF64_LIFETIME=1800
RA_INTERVAL=600
RA_UNSOLICITED=on
RA_M=off
RA_O=on
RA_RDNSS=on
RA_MTU=auto
BNG_MTU=1492
IPV4=off
